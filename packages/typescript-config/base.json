{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "incremental": false,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@workspace/ui": ["../ui/src/index.ts"],
      "@workspace/ui/*": ["../ui/src/*"],
      "@workspace/store": ["../store/src/index.ts"],
      "@workspace/store/*": ["../store/src/*"]
    }
  }
}
