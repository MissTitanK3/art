{
  "name": "shadcn-ui-monorepo",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency=20",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "ci:local": "node scripts/ci-local.mjs",
    "create:region": "node scripts/create-region.mjs",
    "new:course": "node scripts/new-course.mjs",
    "generate:academy-groups": "node scripts/generate-academy-groups.mjs",
    "generate:academy-course-details": "node scripts/generate-academy-course-details.mjs",
    "prebuild": "pnpm -w run generate:academy-course-details && pnpm -w run generate:academy-groups && pnpm -w run validate:academy",
    "validate:academy": "node scripts/validate-academy-content.mjs",
    "check:regions": "node scripts/check-align-regions.mjs",
    "check:regions:ts": "node --loader ts-node/esm scripts/check-align-regions.ts",
    "check:regions:demo": "node scripts/check-align-regions.mjs --demo",
    "check:regions:diff": "node scripts/check-align-regions.mjs --format diff",
    "check:regions:diff:verbose": "node scripts/check-align-regions.mjs --format diff --verbose",
    "check:regions:git": "node scripts/check-align-regions.mjs --git",
    "check:regions:staged": "node scripts/check-align-regions.mjs --staged",
    "check:regions:whitelist": "node scripts/check-align-regions.mjs --whitelist-file scripts/check-align-whitelist.txt",
    "check:regions:demo:diff": "node scripts/check-align-regions.mjs --demo --format diff",
    "check:regions:ci": "node scripts/check-align-regions.mjs --format diff --git",
    "check:regions:full": "echo \"Running region alignment (scan + manifest/sw checks + secret-scan)...\" && node scripts/check-align-regions.mjs --format diff --run-lint --run-typecheck --whitelist-file scripts/check-align-whitelist.txt --output .check-unaligned-region/report.json --out-dir .check-unaligned-region --verbose || true && echo \"Artifacts written to .check-unaligned-region/ (report.json, report.md, pr_suggestion.md, per-region .diff files)\" && echo \"Prioritizing diffs...\" && node scripts/prioritize-diffs.mjs && echo \"Posting check report...\" && node scripts/post-check-report.mjs",
    "sync:regions:full": "node scripts/sync-align-regions.mjs",
    "sanity-check": "bash ./scripts/sanity-check.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.20",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.19.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/store": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/ui": "workspace:*",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "gray-matter": "^4.0.3",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.7.3",
    "minimatch": "^9.0.2",
    "ts-node": "^10.9.1"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@react-leaflet/core": "^3.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/typography": "^0.5.19",
    "@turf/turf": "^7.2.0",
    "date-fns": "^4.1.0",
    "html-to-image": "^1.11.13",
    "html2canvas-pro": "^1.5.11",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "luxon": "^3.7.1",
    "nanoid": "^5.1.5",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^3.1.1",
    "react-qr-code": "^2.0.18",
    "recharts": "2.15.4",
    "satori": "^0.18.2",
    "sonner": "^2.0.7",
    "superjson": "^2.2.2",
    "swr": "^2.3.6",
    "zod": "^3.25.76",
    "zustand": "^5.0.7"
  }
}
